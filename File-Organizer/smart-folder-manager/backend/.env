# MongoDB Configuration
# Update these with your MongoDB Atlas or local MongoDB connection details

# MongoDB URI - change this to your MongoDB connection string
# Local MongoDB example: mongodb://localhost:27017
# MongoDB Atlas example: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017

# Database name
MONGO_DB_NAME=smart_file_organizer
